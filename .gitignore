# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (only the placeholder example is tracked)
.env*
.env
.env.*
!.env.example

# Common secret files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
secrets/
.secret/
.secrets/
credentials/
credentials.json
service-account*.json
*.p8
.npmrc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Personal local scripts (never committed)
/scripts/local/

# ---- Project-specific ----
# Client deliverables kept outside Git
/deliverables/
