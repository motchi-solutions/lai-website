# Environment variables. Placeholders only; never commit .env.local.
# NEXT_PUBLIC_* values are public and baked in at build time (redeploy after
# changing). Everything else is server-only. Empty means unset.
# Restart `npm run dev` after edits. VERCEL, VERCEL_ENV and NODE_ENV are set
# by the platform; do not set them.
#
#   Variable                                Local          Vercel Production     Vercel Preview
#   NEXT_PUBLIC_SITE_URL                    optional       required              optional
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY          test key       required              required
#   TURNSTILE_SECRET_KEY                    test secret    required, Sensitive   required
#   GOOGLE_SHEETS_SPREADSHEET_ID            send tests     required              required
#   GCP_PROJECT_NUMBER                      send tests     required              required
#   GCP_SERVICE_ACCOUNT_EMAIL               send tests     required              required
#   GCP_WORKLOAD_IDENTITY_POOL_ID           send tests     required              required
#   GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID  send tests     required              required
#   UPSTASH_REDIS_REST_URL                  optional       required              required
#   UPSTASH_REDIS_REST_TOKEN                optional       required, Sensitive   required
#
# Google access is keyless (Vercel OIDC + Workload Identity Federation); there
# is no service-account key. For local Sheets writes, run `npx vercel env pull
# .env.development.local` to get a development OIDC token (see README).


# ---- Local (.env.local) -----------------------------------------------------

# Public website URL, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile test keys (always pass). Real keys go in Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Only for real send tests. Rows go to the real spreadsheet.
GOOGLE_SHEETS_SPREADSHEET_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Optional locally; production needs them for durable rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ---- Vercel Production (set in Vercel, not here) ---------------------------

# NEXT_PUBLIC_SITE_URL=<https://production-domain>

# Cloudflare Turnstile: Managed widget listing the production and preview
# hostnames. The site key is public; the secret key is Sensitive.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site key>
# TURNSTILE_SECRET_KEY=<secret key>

# Google Sheets through Workload Identity Federation.
# GOOGLE_SHEETS_SPREADSHEET_ID=<spreadsheet id from its URL>
# GCP_PROJECT_NUMBER=<numeric project number>
# GCP_SERVICE_ACCOUNT_EMAIL=<name@project.iam.gserviceaccount.com>
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Upstash Redis rate limits.
# UPSTASH_REDIS_REST_URL=<https://...upstash.io>
# UPSTASH_REDIS_REST_TOKEN=<token>
