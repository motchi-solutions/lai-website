# Public website URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.ca

# =============================================================================
# Cloudflare Turnstile (contact form bot check)
# =============================================================================

# Public Turnstile site key used by the browser.
# Local development can use Cloudflare's test key 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Turnstile secret key.
# Local development can use Cloudflare's test secret 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=

# =============================================================================
# Google Sheets
# =============================================================================

# Spreadsheet ID for the form response spreadsheet.
GOOGLE_SHEETS_SPREADSHEET_ID=

# =============================================================================
# Google Cloud Workload Identity Federation
# =============================================================================

# Google Cloud project containing the Workload Identity Pool and the
# form-submission service account.
GCP_PROJECT_ID=

# Numeric Google Cloud project number.
GCP_PROJECT_NUMBER=

# Service account used to write form responses to Google Sheets.
GCP_SERVICE_ACCOUNT_EMAIL=

# Workload Identity Pool configured for Vercel OIDC.
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel

# Vercel OIDC provider inside the Workload Identity Pool.
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Upstash Redis (required in production for durable rate limiting)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token
