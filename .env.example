# Public website URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.ca

# =============================================================================
# Google reCAPTCHA Enterprise
# =============================================================================

# Public reCAPTCHA site key used by the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Server-only Google Cloud API key restricted to the reCAPTCHA Enterprise API.
GOOGLE_RECAPTCHA_API_KEY=

# =============================================================================
# Google Sheets
# =============================================================================

# Spreadsheet ID for the form response spreadsheet.
GOOGLE_SHEETS_SPREADSHEET_ID=

# =============================================================================
# Google Cloud Workload Identity Federation
# =============================================================================

# Google Cloud project containing reCAPTCHA, the Workload Identity Pool,
# and the form-submission service account.
GCP_PROJECT_ID=

# Numeric Google Cloud project number.
GCP_PROJECT_NUMBER=

# Service account used to write form responses to Google Sheets.
GCP_SERVICE_ACCOUNT_EMAIL=

# Workload Identity Pool configured for Vercel OIDC.
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel

# Vercel OIDC provider inside the Workload Identity Pool.
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Upstash Redis (required in production for durable rate limiting)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token
